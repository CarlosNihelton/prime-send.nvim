#!/bin/sh
# Fake prime-agent CLI for tests.

if [ "$1" = "list" ]; then
  if [ "$PRIME_SEND_TEST_LISTING" = "slow" ]; then
    sleep 0.3
  fi
  if [ "$PRIME_SEND_TEST_LISTING" = "large" ]; then
    cat "$(dirname "$0")/golden/list-large.json"
  else
    cat "$(dirname "$0")/golden/list.json"
  fi
  exit 0
fi

if [ "$1" = "send" ]; then
  # Record every delivery when the test environment asks for it.
  if [ -n "$PRIME_SEND_TEST_MARKER" ]; then
    echo x >> "$PRIME_SEND_TEST_MARKER" 2>/dev/null
  fi
  # Echo every argv element NUL-separated to stdout.
  for arg in "$@"; do
    printf '%s\0' "$arg"
  done
  # Capture the argv NUL-separated when the test environment asks for it.
  if [ -n "$PRIME_SEND_TEST_ARGV" ]; then
    for arg in "$@"; do
      printf '%s\0' "$arg"
    done > "$PRIME_SEND_TEST_ARGV"
  fi
  # Fail once when the marker sits beside this script.
  if [ -f "$(dirname "$0")/fail-once" ]; then
    rm -f "$(dirname "$0")/fail-once"
    echo "Error: Unknown active session: $2" >&2
    exit 1
  fi
  exit 0
fi

echo "unknown subcommand: $1" >&2
exit 1
